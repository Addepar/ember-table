{
  "extends": "@ember/app-tsconfig",
  "include": ["app/**/*", "tests/**/*", "types/**/*"],
  // Generated by @docfy/ember-vite from docs/**/*.md.
  "exclude": ["app/templates/docs"],
  // The editor follows imports of `ember-table` into its source (instead of its
  // built declarations) through this reference.
  "references": [{ "path": "../ember-table" }],
  "compilerOptions": {
    // ESLint's no-unused-vars is off for .gts (ember-eslint-parser misreads
    // template references), so the type checker reports unused locals.
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    // `test-app/*` resolves through package.json#exports at runtime.
    "paths": { "test-app/*": ["./app/*"] },
    "types": ["ember-source/types", "vite/client", "@glint/ember-tsc/types"]
  }
}
