{
  "private": true,
  "repository": "https://github.com/Addepar/ember-table",
  "license": "BSD-3-Clause",
  "scripts": {
    "build": "pnpm --filter ember-table build",
    "lint": "pnpm --filter '*' lint",
    "lint:fix": "pnpm --filter '*' lint:fix",
    "prepare": "pnpm build",
    "start": "concurrently 'pnpm:start:*' --restart-after 5000 --prefixColors auto",
    "start:addon": "pnpm --filter ember-table start --no-watch.clearScreen",
    "start:test-app": "pnpm --filter test-app start",
    "test": "pnpm --filter '*' test"
  },
  "packageManager": "pnpm@11.28.2",
  "devDependencies": {
    "@glint/tsserver-plugin": "^2.7.9",
    "concurrently": "^9.2.4",
    "prettier": "^3.9.6",
    "prettier-plugin-ember-template-tag": "^2.1.8",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": "22.x"
  }
}
