{
  "name": "ember-table",
  "version": "6.0.0-12",
  "description": "An addon to support large data set and a number of features around table.",
  "keywords": [
    "ember-addon"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Addepar/ember-table",
    "directory": "ember-table"
  },
  "homepage": "https://Addepar.github.io/ember-table",
  "license": "BSD-3-Clause",
  "author": "",
  "exports": {
    ".": {
      "types": "./declarations/index.d.ts",
      "default": "./dist/index.js"
    },
    "./template-registry": {
      "types": "./declarations/template-registry.d.ts",
      "default": "./dist/template-registry.js"
    },
    "./test-support": {
      "types": "./declarations/test-support/index.d.ts",
      "default": "./dist/test-support/index.js"
    },
    "./default.scss": {
      "sass": "./dist/styles/default.scss",
      "default": "./dist/styles/default.scss"
    },
    "./*": {
      "types": "./declarations/*.d.ts",
      "default": "./dist/*.js"
    },
    "./addon-main.js": "./addon-main.cjs"
  },
  "typesVersions": {
    "*": {
      "*": [
        "declarations/*"
      ]
    }
  },
  "files": [
    "addon-main.cjs",
    "declarations",
    "dist"
  ],
  "scripts": {
    "build": "rollup --config",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm run format",
    "lint:hbs": "ember-template-lint . --no-error-on-unmatched-pattern",
    "lint:hbs:fix": "ember-template-lint . --fix --no-error-on-unmatched-pattern",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "ember-tsc --noEmit",
    "prepack": "rollup --config",
    "release": "release-it",
    "start": "rollup --config --watch",
    "test": "echo 'A v2 addon does not have tests, run tests in test-app'"
  },
  "dependencies": {
    "@ember/render-modifiers": "^4.0.0",
    "@ember/test-waiters": "^4.1.2",
    "@embroider/addon-shim": "^1.10.3",
    "@embroider/macros": "^1.21.3",
    "@html-next/vertical-collection": "^5.0.5",
    "css-element-queries": "^0.4.0",
    "decorator-transforms": "^2.4.0",
    "ember-cli-page-object": "^2.3.2",
    "ember-raf-scheduler": "^0.5.2",
    "hammerjs": "^2.0.8"
  },
  "peerDependencies": {
    "@ember/test-helpers": ">= 3.0.0",
    "@glimmer/component": ">= 1.1.2",
    "ember-source": ">= 5.12.0"
  },
  "peerDependenciesMeta": {
    "@ember/test-helpers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@babel/plugin-transform-typescript": "^7.29.9",
    "@ember/library-tsconfig": "^3.0.0",
    "@ember/test-helpers": "^5.7.0",
    "@embroider/addon-dev": "^8.4.2",
    "@eslint/js": "^9.39.5",
    "@glimmer/component": "^2.1.1",
    "@glint/ember-tsc": "^1.11.6",
    "@glint/template": "^1.9.0",
    "@glint/tsserver-plugin": "^2.7.9",
    "@rollup/plugin-babel": "^7.1.0",
    "babel-plugin-ember-template-compilation": "^4.0.0",
    "concurrently": "^9.2.4",
    "ember-source": "~7.3.0",
    "ember-template-lint": "^7.9.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^12.7.5",
    "eslint-plugin-n": "^17.24.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "prettier-plugin-ember-template-tag": "^2.1.8",
    "release-it": "^19.0.0",
    "rollup": "^4.64.0",
    "rollup-plugin-copy": "^3.5.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "engines": {
    "node": ">= 20.19"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.cjs",
    "app-js": {
      "./components/ember-table-private/row-wrapper.js": "./dist/_app_/components/ember-table-private/row-wrapper.js",
      "./components/ember-table-private/scroll-indicators.js": "./dist/_app_/components/ember-table-private/scroll-indicators.js",
      "./components/ember-table-loading-more.js": "./dist/_app_/components/ember-table-loading-more.js",
      "./components/ember-table-simple-checkbox.js": "./dist/_app_/components/ember-table-simple-checkbox.js",
      "./components/ember-table.js": "./dist/_app_/components/ember-table.js",
      "./components/ember-tbody.js": "./dist/_app_/components/ember-tbody.js",
      "./components/ember-td.js": "./dist/_app_/components/ember-td.js",
      "./components/ember-tfoot.js": "./dist/_app_/components/ember-tfoot.js",
      "./components/ember-th.js": "./dist/_app_/components/ember-th.js",
      "./components/ember-th/resize-handle.js": "./dist/_app_/components/ember-th/resize-handle.js",
      "./components/ember-th/sort-indicator.js": "./dist/_app_/components/ember-th/sort-indicator.js",
      "./components/ember-thead.js": "./dist/_app_/components/ember-thead.js",
      "./components/ember-tr.js": "./dist/_app_/components/ember-tr.js"
    }
  }
}
